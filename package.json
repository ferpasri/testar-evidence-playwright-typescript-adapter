{
    "name": "testar-evidence-playwright",
    "version": "0.3.0",
    "description": "Playwright evidence recording for TypeScript and JavaScript",
    "type": "module",
    "license": "BSD-3-Clause",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./test": {
            "types": "./dist/test.d.ts",
            "import": "./dist/test.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "docs",
        "examples",
        "LICENSE",
        "TODO.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node tools/copy-resources.ts",
        "prepare": "npm run build",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run",
        "check": "npm run typecheck && npm test",
        "test:runner": "playwright test -c tests/runner.config.ts",
        "example": "npm run build && node examples/local-form.ts"
    },
    "dependencies": {
        "testar-evidence": "github:ferpasri/testar-evidence-typescript#v0.3.0"
    },
    "peerDependencies": {
        "playwright": "^1.65.0"
    },
    "devDependencies": {
        "playwright": "1.65.0",
        "typescript": "7.0.2",
        "@types/node": "26.6.6",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ferpasri/testar-evidence-playwright-typescript-adapter.git"
    }
}
